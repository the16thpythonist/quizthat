# Copy to .env (gitignored) and fill in. Nothing here is read at build time —
# the pipeline and the backend load it at startup.

# ElevenLabs, for the question narration and sound effects (pipeline/).
ELEVENLABS_API_KEY=

# Freesound, for sourcing generic effects instead of spending generation quota.
FREESOUND_API_KEY=

# The corpus editor at http://localhost:8000/corpus/ — one shared login for
# whoever curates the questions. Playing a game needs no account; this guards
# only the pages that rewrite question files.
#
# With QUIZTHAT_ADMIN_PASSWORD empty the editor refuses to open, so a server
# nobody configured cannot quietly leave the corpus writable to the network.
QUIZTHAT_ADMIN_USER=admin
QUIZTHAT_ADMIN_PASSWORD=
